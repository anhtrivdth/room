  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "dotenv": "^17.2.3",
    "telegraf": "^4.16.3",
    "zca-js": "2.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
